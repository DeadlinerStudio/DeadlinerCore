selectAll:
SELECT uid, content, category, created_at, importance, updated_at, is_deleted
FROM memory_fragment WHERE is_deleted = 0 ORDER BY created_at DESC;

insertMemory:
INSERT OR IGNORE INTO memory_fragment (uid, content, category, created_at, importance, updated_at, is_deleted)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateMemory:
UPDATE memory_fragment SET content = ?, category = ?, importance = ?, updated_at = ?, is_deleted = ? WHERE uid = ?;

softDeleteMemory:
UPDATE memory_fragment SET is_deleted = 1, updated_at = ? WHERE uid = ?;

insertUserProfile:
INSERT OR IGNORE INTO user_profile (uid, nickname, avatar_file_name, tier, created_at, updated_at, is_deleted)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateUserProfile:
UPDATE user_profile SET nickname = ?, avatar_file_name = ?, tier = ?, updated_at = ?, is_deleted = ? WHERE uid = ?;
