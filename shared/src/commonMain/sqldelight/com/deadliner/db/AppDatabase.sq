CREATE TABLE category (
    uid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    icon_key TEXT NOT NULL,
    color_hex TEXT NOT NULL,
    is_preset INTEGER NOT NULL,
    sort_order INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE habit (
    uid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    color INTEGER,
    icon_key TEXT,
    category_uid TEXT REFERENCES category(uid) ON DELETE SET NULL,
    schedule_kind TEXT NOT NULL,
    schedule_start_on TEXT NOT NULL,
    schedule_end_on TEXT,
    schedule_weekdays_mask INTEGER,
    schedule_algorithm_key TEXT,
    goal_window TEXT NOT NULL,
    goal_target_count INTEGER NOT NULL,
    tracking_mode TEXT NOT NULL,
    tracking_unit TEXT,
    tracking_default_increment INTEGER NOT NULL,
    status TEXT NOT NULL,
    sort_order INTEGER NOT NULL,
    reminder_local_time TEXT,
    reminder_enabled INTEGER,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE task (
    uid TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    note TEXT NOT NULL,
    start_at TEXT,
    due_at TEXT,
    state TEXT NOT NULL,
    completed_at TEXT,
    category_uid TEXT REFERENCES category(uid) ON DELETE SET NULL,
    is_starred INTEGER NOT NULL,
    calendar_event_id INTEGER,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE task_subtask (
    uid TEXT NOT NULL PRIMARY KEY,
    task_uid TEXT NOT NULL REFERENCES task(uid),
    content TEXT NOT NULL,
    is_completed INTEGER NOT NULL,
    sort_order INTEGER NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE focus_session (
    uid TEXT NOT NULL PRIMARY KEY,
    task_uid TEXT NOT NULL,
    task_title_snapshot TEXT NOT NULL,
    mode TEXT NOT NULL,
    planned_duration_seconds INTEGER,
    started_at TEXT NOT NULL,
    ended_at TEXT NOT NULL,
    duration_seconds INTEGER NOT NULL,
    completion_kind TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    target_kind TEXT NOT NULL DEFAULT 'TASK',
    habit_uid TEXT,
    habit_occurred_on TEXT,
    habit_recorded_amount INTEGER
);

CREATE TABLE active_focus_timer (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    session_uid TEXT NOT NULL UNIQUE,
    task_uid TEXT NOT NULL,
    task_title_snapshot TEXT NOT NULL,
    mode TEXT NOT NULL,
    planned_duration_seconds INTEGER,
    state TEXT NOT NULL,
    started_at TEXT NOT NULL,
    running_segment_started_at TEXT,
    accumulated_seconds INTEGER NOT NULL,
    updated_at TEXT NOT NULL,
    target_kind TEXT NOT NULL DEFAULT 'TASK',
    habit_uid TEXT,
    habit_occurred_on TEXT
);

CREATE TABLE habit_record (
    uid TEXT NOT NULL PRIMARY KEY,
    habit_uid TEXT NOT NULL REFERENCES habit(uid),
    occurred_on TEXT NOT NULL,
    count INTEGER NOT NULL,
    status TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE migration_diagnostic (
    diagnostic_key TEXT NOT NULL PRIMARY KEY,
    diagnostic_value INTEGER NOT NULL,
    recorded_at TEXT NOT NULL
);

CREATE TABLE capture_item (
    uid TEXT NOT NULL PRIMARY KEY,
    text TEXT NOT NULL,
    source TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_consumed INTEGER NOT NULL DEFAULT 0,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE memory_fragment (
    uid TEXT NOT NULL PRIMARY KEY,
    content TEXT NOT NULL,
    category TEXT NOT NULL,
    created_at TEXT NOT NULL,
    importance INTEGER NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE memory_user_profile (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    content TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE TABLE user_profile (
    uid TEXT NOT NULL PRIMARY KEY,
    nickname TEXT NOT NULL,
    avatar_file_name TEXT,
    tier TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE changelog (
    id TEXT NOT NULL PRIMARY KEY,
    table_name TEXT NOT NULL,
    record_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    changed_fields TEXT,
    client_timestamp INTEGER NOT NULL,
    server_timestamp INTEGER,
    device_id TEXT NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0
);

-- Preserves the iOS V2 snapshot LWW triple while KMP remains the business-data source.
CREATE TABLE legacy_v2_version (
    entity_kind TEXT NOT NULL,
    entity_uid TEXT NOT NULL,
    ts TEXT NOT NULL,
    ctr INTEGER NOT NULL,
    dev TEXT NOT NULL,
    PRIMARY KEY (entity_kind, entity_uid)
);

CREATE INDEX idx_category_sort ON category(is_deleted, sort_order);
CREATE INDEX idx_task_state_due ON task(is_deleted, state, due_at);
CREATE INDEX idx_task_category ON task(category_uid);
CREATE INDEX idx_subtask_task ON task_subtask(task_uid, sort_order);
CREATE INDEX idx_focus_session_task ON focus_session(is_deleted, task_uid, started_at);
CREATE INDEX idx_focus_session_started ON focus_session(is_deleted, started_at);
CREATE INDEX idx_habit_category ON habit(is_deleted, category_uid, sort_order);
CREATE INDEX idx_habit_record_habit ON habit_record(habit_uid, is_deleted, occurred_on);
CREATE INDEX idx_capture_consumed ON capture_item(is_deleted, is_consumed, created_at);
CREATE TABLE conversation_turn (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at TEXT NOT NULL
);

CREATE INDEX idx_memory_created ON memory_fragment(is_deleted, created_at);
CREATE INDEX idx_conversation_created ON conversation_turn(created_at);
CREATE INDEX idx_changelog_synced ON changelog(synced, server_timestamp);
CREATE INDEX idx_changelog_record ON changelog(table_name, record_id);
CREATE INDEX idx_legacy_v2_version_kind ON legacy_v2_version(entity_kind);

enableForeignKeys:
PRAGMA foreign_keys = 1;

CREATE INDEX idx_focus_session_habit ON focus_session(is_deleted, target_kind, habit_uid, started_at);
CREATE TABLE ai_session (
    session_id TEXT NOT NULL PRIMARY KEY,
    payload TEXT NOT NULL
);

CREATE TABLE ai_execution_receipt (
    action_id TEXT NOT NULL PRIMARY KEY,
    tool_name TEXT NOT NULL,
    arguments TEXT NOT NULL,
    payload TEXT NOT NULL
);
