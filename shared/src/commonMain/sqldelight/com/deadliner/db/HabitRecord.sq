selectForHabit:
SELECT uid, habit_uid, occurred_on, count, status, created_at, updated_at, is_deleted
FROM habit_record WHERE habit_uid = ? AND is_deleted = 0 ORDER BY occurred_on DESC, created_at DESC;

selectAllForHabit:
SELECT uid, habit_uid, occurred_on, count, status, created_at, updated_at, is_deleted
FROM habit_record WHERE habit_uid = ? ORDER BY occurred_on DESC, created_at DESC;

selectAll:
SELECT uid, habit_uid, occurred_on, count, status, created_at, updated_at, is_deleted
FROM habit_record WHERE is_deleted = 0 ORDER BY habit_uid, occurred_on DESC, created_at DESC;

selectAllIncludingDeleted:
SELECT uid, habit_uid, occurred_on, count, status, created_at, updated_at, is_deleted
FROM habit_record ORDER BY habit_uid, occurred_on DESC, created_at DESC;

insertHabitRecord:
INSERT OR IGNORE INTO habit_record (uid, habit_uid, occurred_on, count, status, created_at, updated_at, is_deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateHabitRecord:
UPDATE habit_record SET habit_uid = ?, occurred_on = ?, count = ?, status = ?, updated_at = ?, is_deleted = ?
WHERE uid = ?;

softDeleteHabitRecord:
UPDATE habit_record SET is_deleted = 1, updated_at = ? WHERE uid = ?;
