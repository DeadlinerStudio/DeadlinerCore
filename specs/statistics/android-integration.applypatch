+/** Uses the existing Overview card/theme conventions below the page's glass chrome. */
+@Composable
+internal fun FocusOverviewCards(state: FocusOverviewState) {
+    val data = state.data
+    if (data == null) {
+        FocusStatusCard(state)
+        return
+    }
+    FocusStatisticsCard(stringResource(R.string.focus_stats_summary)) {
+        if (state.hasError) Text(stringResource(R.string.focus_stats_error), color = MaterialTheme.colorScheme.error)
+        FocusMetricGrid(listOf(
+            stringResource(R.string.focus_stats_today) to focusDuration(data.today.totalDurationSeconds),
+            stringResource(R.string.focus_stats_week) to focusDuration(data.thisWeek.totalDurationSeconds),
+            stringResource(R.string.focus_stats_month) to focusDuration(data.thisMonth.summary.totalDurationSeconds),
+            stringResource(R.string.focus_stats_all_time) to focusDuration(data.allTime.totalDurationSeconds),
+        ))
+        Text(stringResource(R.string.focus_stats_month_details,
+            data.thisMonth.summary.sessionCount, data.thisMonth.summary.activeDayCount),
+            style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        Text(stringResource(R.string.focus_stats_recorded_only),
+            style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+    FocusDistributionCard(data.thisMonth, stringResource(R.string.focus_stats_month_distribution))
+}
+
+@Composable
+internal fun FocusTrendCards(state: FocusOverviewState) {
+    val data = state.data
+    if (data == null) {
+        FocusStatusCard(state)
+        return
+    }
+    FocusDurationChartCard(stringResource(R.string.focus_stats_daily), data.daily)
+    FocusDurationChartCard(stringResource(R.string.focus_stats_weekly), data.weekly)
+    FocusDurationChartCard(stringResource(R.string.focus_stats_monthly), data.monthly, monthLabels = true)
+}
+
+@Composable
+internal fun FocusLastMonthCards(state: FocusOverviewState) {
+    val review = state.data?.lastMonth
+    if (review == null) {
+        FocusStatusCard(state, horizontalPadding = 0.dp)
+        return
+    }
+    val summary = review.current.summary
+    FocusStatisticsCard(stringResource(R.string.focus_stats_last_month), horizontalPadding = 0.dp) {
+        if (state.hasError) Text(stringResource(R.string.focus_stats_error), color = MaterialTheme.colorScheme.error)
+        FocusMetricGrid(listOf(
+            stringResource(R.string.focus_stats_duration) to focusDuration(summary.totalDurationSeconds),
+            stringResource(R.string.focus_stats_sessions) to summary.sessionCount.toString(),
+            stringResource(R.string.focus_stats_average) to focusDuration(summary.averageSessionDurationSeconds),
+            stringResource(R.string.focus_stats_days) to summary.activeDayCount.toString(),
+        ))
+        val percent = review.durationChangePercent
+        val change = when {
+            percent != null -> stringResource(R.string.focus_stats_comparison,
+                if (review.durationChangeSeconds >= 0) "+" else "−",
+                focusDuration(abs(review.durationChangeSeconds)),
+                String.format(Locale.getDefault(), "%+.1f%%", percent))
+            summary.totalDurationSeconds > 0 -> stringResource(R.string.focus_stats_first_month)
+            else -> stringResource(R.string.focus_stats_both_months_empty)
+        }
+        Text(change, style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+    FocusDurationChartCard(stringResource(R.string.focus_stats_last_month_daily), review.current.daily,
+        horizontalPadding = 0.dp, dayOfMonthLabels = true)
+    FocusDistributionCard(review.current, stringResource(R.string.focus_stats_last_month_distribution), horizontalPadding = 0.dp)
+}
+
+@Composable
+private fun FocusStatusCard(state: FocusOverviewState, horizontalPadding: Dp = 16.dp) {
+    FocusStatisticsCard(stringResource(R.string.focus_stats_summary), horizontalPadding) {
+        Text(stringResource(when {
+            state.hasError -> R.string.focus_stats_error
+            state.isLoading -> R.string.focus_stats_loading
+            else -> R.string.focus_stats_empty
+        }), style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
+
+@Composable
+private fun FocusMetricGrid(metrics: List<Pair<String, String>>) {
+    metrics.chunked(2).forEach { pair ->
+        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(16.dp)) {
+            pair.forEach { (label, value) ->
+                Column(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                    Text(label, style = MaterialTheme.typography.bodyMedium,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant)
+                    Text(value, style = MaterialTheme.typography.titleLarge.copy(fontWeight = FontWeight.Medium),
+                        color = rememberOverviewIndicatorPalette().total)
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun FocusDurationChartCard(
+    title: String,
+    points: List<FocusDurationPoint>,
+    horizontalPadding: Dp = 16.dp,
+    monthLabels: Boolean = false,
+    dayOfMonthLabels: Boolean = false,
+) {
+    val total = points.sumOf { it.durationSeconds }
+    val maximum = points.maxOfOrNull { it.durationSeconds }?.coerceAtLeast(1) ?: 1
+    val color = rememberOverviewIndicatorPalette().total
+    FocusStatisticsCard(title, horizontalPadding) {
+        Text(focusDuration(total), style = MaterialTheme.typography.titleLarge,
+            color = color, fontWeight = FontWeight.Medium)
+        if (points.isNotEmpty()) Text(points.first().startDate + " — " + points.last().endDateExclusive,
+            style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        if (total == 0L) {
+            Text(stringResource(R.string.focus_stats_empty), style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+        // Compact daily/monthly bars; no count-based chart is reused for durations.
+        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(3.dp),
+            verticalAlignment = Alignment.Bottom) {
+            points.forEachIndexed { index, point ->
+                val description = point.startDate + ": " + focusDuration(point.durationSeconds)
+                Column(Modifier.weight(1f).semantics(mergeDescendants = true) { contentDescription = description },
+                    horizontalAlignment = Alignment.CenterHorizontally) {
+                    Box(Modifier.fillMaxWidth().height(100.dp), contentAlignment = Alignment.BottomCenter) {
+                        Box(Modifier.fillMaxWidth(0.72f)
+                            .height((point.durationSeconds.toDouble() / maximum * 96).toFloat().coerceAtLeast(2f).dp)
+                            .clip(RoundedCornerShape(4.dp))
+                            .background(if (point.durationSeconds > 0) color else color.copy(alpha = 0.12f)))
+                    }
+                    val label = when {
+                        monthLabels -> point.startDate.substring(5, 7)
+                        dayOfMonthLabels -> if (index == 0 || (index + 1) % 5 == 0 || index == points.lastIndex)
+                            (index + 1).toString() else ""
+                        else -> point.startDate.substring(5)
+                    }
+                    Text(label, style = MaterialTheme.typography.labelSmall,
+                        maxLines = 1, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                }
+            }
+        }
+        Text(stringResource(R.string.focus_stats_chart_scale, focusDuration(maximum.takeIf { total > 0 } ?: 0)),
+            style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
+
+@Composable
+private fun FocusDistributionCard(
+    snapshot: FocusStatisticsSnapshot,
+    title: String,
+    horizontalPadding: Dp = 16.dp,
+) {
+    FocusStatisticsCard(title, horizontalPadding) {
+        if (snapshot.summary.sessionCount == 0) {
+            Text(stringResource(R.string.focus_stats_empty), style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant)
+        } else {
+            Text(stringResource(R.string.focus_stats_top_tasks), style = MaterialTheme.typography.titleMedium)
+            snapshot.tasks.take(5).forEach { task ->
+                FocusDistributionRow(task.taskTitle, task.durationSeconds, snapshot.summary.totalDurationSeconds)
+            }
+            Spacer(Modifier.height(4.dp))
+            Text(stringResource(R.string.focus_stats_categories), style = MaterialTheme.typography.titleMedium)
+            snapshot.categories.take(5).forEach { category ->
+                FocusDistributionRow(category.categoryTitle ?: stringResource(R.string.focus_stats_uncategorized),
+                    category.durationSeconds, snapshot.summary.totalDurationSeconds)
+            }
+            Text(stringResource(R.string.focus_stats_current_category),
+                style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
+
+@Composable
+private fun FocusDistributionRow(title: String, seconds: Long, total: Long) {
+    val fraction = (seconds.toDouble() / total.coerceAtLeast(1)).toFloat().coerceIn(0f, 1f)
+    val color = rememberOverviewIndicatorPalette().total
+    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(title, Modifier.weight(1f), style = MaterialTheme.typography.bodyMedium,
+                maxLines = 2, overflow = TextOverflow.Ellipsis)
+            Text(focusDuration(seconds), style = MaterialTheme.typography.bodyMedium, color = color)
+        }
+        Box(Modifier.fillMaxWidth().height(4.dp).clip(RoundedCornerShape(2.dp)).background(color.copy(alpha = 0.12f))) {
+            Box(Modifier.fillMaxWidth(fraction).height(4.dp).background(color))
+        }
+    }
+}
+
+@Composable
+private fun FocusStatisticsCard(title: String, horizontalPadding: Dp = 16.dp, content: @Composable ColumnScope.() -> Unit) {
+    Card(
+        modifier = Modifier.padding(horizontal = horizontalPadding, vertical = 8.dp).fillMaxWidth(),
+        shape = RoundedCornerShape(dimensionResource(R.dimen.item_corner_radius)),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+    ) {
+        Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(title, style = MaterialTheme.typography.titleLarge, color = MaterialTheme.colorScheme.onSurface)
+            content()
+        }
+    }
+}
+
+@Composable
+private fun focusDuration(seconds: Long): String = when {
+    seconds < 60 -> stringResource(R.string.focus_stats_seconds, seconds)
+    seconds < 3_600 -> stringResource(R.string.focus_stats_minutes, seconds / 60)
+    else -> stringResource(R.string.focus_stats_hours_minutes, seconds / 3_600, seconds % 3_600 / 60)
+}
